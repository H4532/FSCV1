# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only (emails, cron, client survey)

# Public URL of the app (used in email links and QR codes)
APP_BASE_URL=http://localhost:3000

# Email: "graph" (Microsoft 365) or "console" (log only, for development)
MAIL_PROVIDER=console
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=events@yourhotel.com

# Protects /api/cron/alerts (call every 10-15 min from Vercel Cron, pg_cron or Task Scheduler)
CRON_SECRET=change-me
